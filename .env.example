# GEMINI_API_KEY: Optional for Gemini Multilingual AI Emotion & Gesture Director.
# Without this key, ccavatarstudio automatically runs its built-in Offline Multilingual Rule Engine.
GEMINI_API_KEY=""

# OPENROUTER_API_KEY: Optional alternative remote AI semantic cue planner (e.g. openrouter/free).
OPENROUTER_API_KEY=""

# HF_TOKEN & HF_TOKEN_2: Optional Hugging Face tokens for Python voiceover_pipeline.py (OmniVoice cloning)
# ccavatarstudio automatically fails over from HF_TOKEN -> HF_TOKEN_2 if quota/rate-limits are hit.
HF_TOKEN=""
HF_TOKEN_2=""

# EXPORT_DIR: Folder where server-rendered MP4, Transparent WebM & WAV files are auto-saved
EXPORT_DIR="./exports"

# APP_URL: The URL where this applet is hosted (injected automatically at runtime).
APP_URL="MY_APP_URL"
